#!/usr/bin/env python3
"""Hook dispatcher used by hooks/hooks.json.

    python3 -I bin/em-hook hook <event>
    python3 -I bin/em-hook status

Adds ``src/`` to sys.path so the plugin runs from a checkout with no install.
Run with ``-I`` so a planted module in the working directory is never imported.
"""
import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_ROOT, "src"))

from epistemic_monitor.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
